# ControlPlane.ai — example environment file
#
# Copy to `.env` and fill in. NEVER commit the real `.env`.
#
# Every variable is prefixed `CP_` on purpose. Claude Code and other tools set ambient
# ANTHROPIC_* variables in the shell, and the Anthropic SDK auto-reads ANTHROPIC_API_KEY /
# ANTHROPIC_BASE_URL. The prefix guarantees this app never silently inherits another
# tool's credentials or proxy endpoint.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
CP_ENVIRONMENT=dev
CP_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# "mock"      -> deterministic fixtures from data/demo/scenarios.yaml (no network).
#                Used by the whole test suite. Works with zero credentials.
# "anthropic" -> real API calls.
CP_LLM_PROVIDER=mock

# Required only when CP_LLM_PROVIDER=anthropic
CP_ANTHROPIC_API_KEY=
CP_ANTHROPIC_MODEL=claude-sonnet-5
# Leave blank to use the official endpoint. Set only if you front the API with a gateway.
CP_ANTHROPIC_BASE_URL=
CP_LLM_MAX_TOKENS=1024
CP_LLM_TIMEOUT_S=30

# ---------------------------------------------------------------------------
# Graph store — Neo4j Aura (grounding evidence)
# ---------------------------------------------------------------------------
# Leave CP_NEO4J_URI blank to fall back to the deterministic in-memory graph.
# The app runs and every demo scenario passes either way; /health reports which
# backend is live so the fallback is never silent.
CP_NEO4J_URI=
CP_NEO4J_USER=neo4j
CP_NEO4J_PASSWORD=
CP_NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Document store — MongoDB Atlas (audit trail)
# ---------------------------------------------------------------------------
# Leave CP_MONGO_URI blank to fall back to the in-memory audit repository.
# Audit records then live only for the process lifetime — fine for tests, not for a demo
# where you want to show persistence.
CP_MONGO_URI=
CP_MONGO_DB=controlplane

# ---------------------------------------------------------------------------
# Policy
# ---------------------------------------------------------------------------
CP_POLICY_DIR=policies
CP_DEFAULT_POLICY_PROFILE=default

# ---------------------------------------------------------------------------
# Cost estimation (USD per 1M tokens)
# ---------------------------------------------------------------------------
# PROTOTYPE ASSUMPTION. Update to your provider's real published rates before quoting
# any figure. These are illustrative defaults, not authoritative pricing.
CP_PRICE_INPUT_PER_MTOK=3.00
CP_PRICE_OUTPUT_PER_MTOK=15.00
